This scripts represent store procedure in silver database


DELIMITER $$
CREATE PROCEDURE silver.load_silver ()
BEGIN

TRUNCATE TABLE silver.crm_customer_info;

INSERT INTO silver.crm_customer_info (
customer_id,
customer_key,
customer_firstname,
customer_lastname,
customer_marital_status,
customer_gender,
customer_create_date)

SELECT 
customer_id,
customer_key,
TRIM(customer_firstname) AS customer_firstname,
TRIM(customer_lastname) AS customer_lastname,
CASE WHEN UPPER(TRIM(customer_marital_status))= 'M' THEN 'Married'
     WHEN UPPER(TRIM(customer_marital_status))= 'S' THEN 'Single'
ELSE 'n/a'
END customer_marital_status,
CASE WHEN UPPER(TRIM(customer_gender))= 'M' THEN 'Male'
     WHEN UPPER(TRIM(customer_gender))= 'F' THEN 'Female'
ELSE 'n/a'
END customer_gender,
customer_create_date
FROM (
    SELECT *,
           ROW_NUMBER() OVER (
               PARTITION BY customer_id
               ORDER BY customer_create_date DESC
           ) AS repeatable
    FROM bronze.crm_customer_info
) t
WHERE repeatable = 1
  AND customer_id <> 0;
  
TRUNCATE TABLE silver.crm_product_info;

INSERT INTO silver.crm_product_info (
    product_id,
    cat_id,
    product_key,
    product_nm,
    product_cost,
    product_line,
    product_start_date,
    product_end_date
    )
SELECT
    product_id,
    REPLACE (SUBSTRING(product_key, 1, 5), '-', '_') AS cat_id,
	SUBSTRING(product_key, 7) AS product_key,
    product_nm,
    IFNULL(product_cost, 0) AS product_cost,
    CASE WHEN UPPER(TRIM(product_line)) = 'M' THEN 'Mountain'
         WHEN UPPER(TRIM(product_line)) = 'R' THEN 'Road'
         WHEN UPPER(TRIM(product_line)) = 'S' THEN 'Sales'
         WHEN UPPER(TRIM(product_line)) = 'T' THEN 'Touring'
         ELSE 'n/a'
	END AS  product_line,
    CAST(product_start_date AS DATE) AS product_start_date,
 
    CAST(
        DATE_SUB(
            LEAD(product_start_date) OVER (
                PARTITION BY product_key
                ORDER BY product_start_date
            ),
            INTERVAL 1 DAY
        ) AS DATE
    ) AS product_end_date
FROM bronze.crm_product_info ;

TRUNCATE TABLE silver.crm_sales_details;

INSERT INTO silver.crm_sales_details (
    sales_ord_num,
    sales_prd_key,
    sales_cust_id,
    sales_order_dt,
    sales_ship_dt,
    sales_due_dt,
    sales_sales,
    sales_quantity,
    sales_price
    )
SELECT
    sales_ord_num,
    sales_prd_key,
    sales_cust_id,
    CASE WHEN sales_order_dt = 0 OR LENGTH(sales_order_dt) <> 8 THEN NULL
		ELSE CAST(CAST(sales_order_dt AS CHAR)AS DATE)
	END sales_order_dt,
    CASE WHEN sales_ship_dt = 0 OR LENGTH(sales_ship_dt) <> 8 THEN NULL
		ELSE CAST(CAST(sales_ship_dt AS CHAR)AS DATE)
	END sales_ship_dt,
    CASE WHEN sales_due_dt = 0 OR LENGTH(sales_due_dt) <> 8 THEN NULL
		ELSE CAST(CAST(sales_due_dt AS CHAR)AS DATE)
	END sales_due_dt,
    CASE WHEN sales_sales IS NULL OR sales_sales <= 0 OR sales_sales <> (sales_quantity * ABS(sales_price))
	 THEN sales_quantity * ABS(sales_price)
     ELSE sales_sales
END AS sales_sales,
    sales_quantity,
    CASE WHEN sales_price IS NULL OR sales_price <= 0
	 THEN sales_sales / NULLIF(sales_quantity, 0)
     ELSE sales_price
END AS sales_price
    FROM bronze.crm_sales_details;
    
    TRUNCATE TABLE silver.erp_customer;
    
    INSERT INTO silver.erp_customer (
    cid,
    bdate,
    gender
    )
SELECT 
    CASE WHEN cid LIKE 'NAS%' THEN SUBSTRING(cid, 4)
    ELSE cid
    END AS cid,
    CASE WHEN bdate > CURDATE() THEN NULL
    ELSE bdate
    END AS bdate,
   CASE 
        WHEN UPPER(TRIM(REPLACE(REPLACE(gender, CHAR(13), ''), CHAR(10), ''))) LIKE 'M%' THEN 'Male'
        WHEN UPPER(TRIM(REPLACE(REPLACE(gender, CHAR(13), ''), CHAR(10), ''))) LIKE 'F%' THEN 'Female'
        ELSE 'n/a'
    END AS gender
FROM bronze.erp_customer; 

    TRUNCATE TABLE silver.erp_location;
    
    INSERT INTO silver.erp_location(
cid,
country
)
SELECT
    REPLACE(cid, '-', '') AS cid,

    CASE 
        WHEN clean_country IN ('DE') THEN 'Germany'
        WHEN clean_country IN ('US', 'USA') THEN 'United States'
        WHEN clean_country = '' OR clean_country IS NULL THEN 'n/a'
        ELSE clean_country
    END AS country

FROM (
    SELECT *,
        UPPER(TRIM(REPLACE(country, CHAR(13), ''))) AS clean_country
    FROM bronze.erp_location
) t;

    TRUNCATE TABLE silver.erp_category;
    
    INSERT INTO silver.erp_category(
id,
cat,
subcat,
maintenance
)
SELECT
id,
cat,
subcat,
maintenance
FROM bronze.erp_category;

END $$
DELIMITER ;
