I used mysql for this project so I can use direct data import function or manual import. here are the code for manual import

USE bronze;

LOAD DATA LOCAL INFILE '/Users/source.csv'
INTO TABLE bronze.crm_customer_info
FIELDS TERMINATED BY ','
LINES TERMINATED BY '\n'
IGNORE 1 LINES
(customer_id, customer_key, customer_firstname, customer_lastname, customer_marital_status, customer_gender, customer_create_date);

LOAD DATA LOCAL INFILE '/Users/source.csv'
INTO TABLE bronze.crm_product_info
FIELDS TERMINATED BY ','
LINES TERMINATED BY '\n'
IGNORE 1 LINES
(product_id, product_key, product_nm, product_cost, product_line, product_start_date, product_end_date);

LOAD DATA LOCAL INFILE '/Users/source.csv'
INTO TABLE bronze.crm_sales_details
